# Build artifacts
target/
node_modules/
dist/

# Local-only docs and scratch (hybrid pattern)
.tsundoku/

# Data
data/
docker/data/
*.db
*.db-shm
*.db-wal
*.log
logs/

# Local config (committed via *.example.toml; *.docker.toml is also committed).
# Any `<stem>.local.<ext>` sibling next to a committed config is auto-merged
# on top of it by td_config::load and stays local-only.
tsundoku.toml
tsundoku.yaml
config/tsundoku.toml
config/tsundoku.yaml
config/*.local.*

# Local env vars for docker compose (committed via .env.example)
.env

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp
*.tmp

# Tooling
.playwright-mcp/
.claude/local/

# Generated frontend bits
web/coverage/

# Playwright screenshot captures (regenerated by `make screenshots`)
screenshots/output/

# Docusaurus docs site
docs/build/
docs/.docusaurus/
docs/.cache-loader/
# OpenAPI reference pages — regenerated from web/openapi.json on every
# build (via `gen-api-docs && docusaurus build`). The `apiSidebar.ts`
# conditional-require gracefully degrades to an empty API sidebar on
# fresh checkouts that haven't run gen-api-docs yet.
docs/docs/api/
