# Development Dockerfile with hot reload (cargo-watch)

FROM rust:1.95-alpine

RUN apk add --no-cache \
    pkgconf \
    openssl-dev \
    openssl-libs-static \
    musl-dev \
    build-base \
    curl \
    libstdc++ \
    libgcc \
    clang \
    mold \
    nodejs \
    npm \
    sqlite

WORKDIR /app

# Pre-materialize the project's pinned toolchain so the runtime bind-mount
# doesn't surprise rustup into re-downloading everything. The base image
# ships the default profile; rust-toolchain.toml asks for minimal+rustfmt
# +clippy, and that profile mismatch alone is enough to trigger a full
# component sync the first time cargo runs.
COPY rust-toolchain.toml ./
RUN rustup show active-toolchain || rustup toolchain install

RUN cargo install cargo-watch cargo-nextest --locked

# Copy only workspace manifests so the dep-cache layer survives source edits.
# Add one COPY line per workspace crate when the project grows.
COPY Cargo.toml Cargo.lock ./
COPY migration/Cargo.toml ./migration/
COPY crates/tsundoku/Cargo.toml ./crates/tsundoku/
COPY crates/td-config/Cargo.toml ./crates/td-config/
COPY crates/td-db/Cargo.toml ./crates/td-db/
COPY crates/td-metadata/Cargo.toml ./crates/td-metadata/
COPY crates/td-metadata-mangabaka/Cargo.toml ./crates/td-metadata-mangabaka/

# Stub source files so the dependency layer can build, then drop every
# workspace-member fingerprint so the real bind-mounted source rebuilds.
# The fingerprint globs must use cargo's *package* names (hyphens), not the
# Rust crate names (underscores). cargo writes
# `target/debug/.fingerprint/<package>-<hash>/`, e.g. `td-metadata-*`, NOT
# `td_metadata_*`. A wrong glob matches nothing, leaves a stub-compiled
# rlib in target/debug/deps/ that cargo links, and surfaces at container
# start as "could not find <Symbol> in <crate>".
RUN find ./crates -mindepth 1 -maxdepth 1 -type d | while read -r dir; do \
        mkdir -p "$dir/src" && \
        if [ -f "$dir/Cargo.toml" ] && grep -q "\[\[bin\]\]" "$dir/Cargo.toml"; then \
            echo "fn main() {}" > "$dir/src/main.rs"; \
        else \
            : > "$dir/src/lib.rs"; \
        fi; \
    done && \
    mkdir -p migration/src && \
    echo "pub use sea_orm_migration::prelude::*; pub struct Migrator; impl MigratorTrait for Migrator { fn migrations() -> Vec<Box<dyn MigrationTrait>> { vec![] } }" > migration/src/lib.rs && \
    cargo build && \
    find ./crates -mindepth 2 -maxdepth 2 -name src -type d -exec rm -rf {} + && \
    rm -rf migration/src && \
    find target/debug/.fingerprint \
        \( -name 'tsundoku-*' -o -name 'td-*' -o -name 'migration-*' \) \
        -prune -exec rm -rf {} + 2>/dev/null || true

# The real source is bind-mounted via docker compose; cargo watch picks up changes.
EXPOSE 8080

CMD ["cargo", "watch", \
    "-w", "Cargo.toml", \
    "-w", "Cargo.lock", \
    "-w", "crates/", \
    "-w", "migration/", \
    "-i", "web/**", \
    "-i", ".tsundoku/**", \
    "-i", "*.md", \
    "-i", "Dockerfile*", \
    "-i", "docker-compose*.yml", \
    "-x", "run -- serve --config /app/config/tsundoku.docker.toml"]
