# Copy to .env and fill in the values. `docker compose` reads this file at
# the project root and passes each variable into the container via
# `env_file: .env` (see docker-compose.yml).
#
# Every key uses the standard tsundoku env layout: `TSUNDOKU_` prefix with
# `__` as the nesting separator. Anything settable in tsundoku.toml is
# settable here.

# --- MangaBaka provider ---------------------------------------------------

# API key sent as the `x-api-key` header. Required when api_fallback=true
# (the docker-compose default) and you want live API calls on cache misses.
# Without a key the provider runs offline-only against the downloaded dump.
TSUNDOKU_PROVIDERS__MANGABAKA__API_KEY=

# --- Auth -----------------------------------------------------------------

# Bearer token for write endpoints (POST/PATCH/DELETE). Writes return 503
# `Misconfigured` when this is unset, so set it before touching anything
# that mutates state (manual review queue resolutions, source polls, etc.).
TSUNDOKU_AUTH__ADMIN_TOKEN=

# Optional read-side key. Only needed if you also flip
# `auth.read_requires_auth = true` in tsundoku.toml.
# TSUNDOKU_AUTH__API_KEY=
