{
  "openapi": "3.1.0",
  "info": {
    "title": "tsundoku API",
    "description": "Manga discovery service that polls sources and resolves releases to MangaBaka series",
    "contact": {
      "name": "Sylvain Cau",
      "email": "sylvain.cau@gmail.com"
    },
